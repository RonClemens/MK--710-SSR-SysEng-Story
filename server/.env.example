# --- Server ---
PORT=3001

# --- AI Assistant master switch ---
# Set to false to disable the AI Assistant entirely - the app then makes zero
# external API calls and the panel shows as disabled. Users can also disable
# it from the UI toggle regardless of this setting.
AI_ASSISTANT_ENABLED=true

# --- Provider selection ---
AI_PROVIDER=public                # public | bedrock

# --- Mode: public (Anthropic direct API) ---
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-5   # confirm current recommended model string at build time

# --- Mode: bedrock (AWS GovCloud, CUI-capable - not active in this build phase) ---
AWS_REGION=                       # e.g. us-gov-west-1
AWS_BEARER_TOKEN_BEDROCK=         # Bedrock API key / bearer token, if org issues one
AWS_ACCESS_KEY_ID=                # alternative to bearer token, if org issues IAM creds instead
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_MODEL_ID=                 # e.g. anthropic.claude-sonnet-5 - confirm exact id with AWS account
BEDROCK_GATEWAY_BASE_URL=         # optional, only if org fronts Bedrock with an internal gateway
